msgstr "Un raggio di 16px viene applicato a tutti gli angoli."

#: src/pixvisualize/edit.js:1087
msgid "The container corners stay square."
msgstr "Gli angoli del contenitore restano quadrati."

#: inc/Elementor/PixVisualizeWidget.php:672
